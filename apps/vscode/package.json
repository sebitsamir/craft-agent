{
  "name": "junub-agent-vscode",
  "displayName": "Junub Agent",
  "description": "Universal Creator VS Code Extension",
  "version": "0.3.0",
  "publisher": "junub-agent",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:junubAgent.inspectWorkspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "junubAgent.inspectWorkspace",
        "title": "Junub Agent: Inspect Workspace"
      },
      {
        "command": "junubAgent.verifyWorkspace",
        "title": "Junub Agent: Verify Workspace"
      },
      {
        "command": "junubAgent.runTask",
        "title": "Junub Agent: Run Task"
      },
      {
        "command": "junubAgent.inspectFilmProject",
        "title": "Junub Agent: Inspect Film Project"
      },
      {
        "command": "junubAgent.loadFilmProject",
        "title": "Junub Agent: Load Film Project"
      },
      {
        "command": "junubAgent.applyFilmPatch",
        "title": "Junub Agent: Apply Film Patch"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "junubAgentTaskProgress",
          "name": "Junub Agent Progress"
        },
        {
          "id": "junubAgentFilmProject",
          "name": "Junub Agent Film"
        }
      ]
    },
        "configuration": {
      "title": "Junub Agent",
      "properties": {
        "junubAgent.dashscopeApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "API key for the Qwen-compatible provider. Works with DashScope, OpenRouter, Together AI, etc.",
          "order": 1
        },
        "junubAgent.qwenBaseUrl": {
          "type": "string",
          "default": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "markdownDescription": "Base URL for the Qwen-compatible API. Change to `https://openrouter.ai/api/v1` for OpenRouter.",
          "order": 2
        },
        "junubAgent.qwenModel": {
          "type": "string",
          "default": "qwen-max",
          "markdownDescription": "Model ID to use. For OpenRouter use `qwen/qwen-2.5-72b-instruct` or `qwen/qwen-turbo`.",
          "order": 3
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
