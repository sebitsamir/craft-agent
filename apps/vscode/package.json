{
  "name": "junub-agent-vscode",
  "displayName": "Junub Agent",
  "description": "Universal Creator VS Code Extension",
  "version": "0.3.0",
  "publisher": "junub-agent",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:junubAgent.inspectWorkspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "junubAgent.inspectWorkspace",
        "title": "Junub Agent: Inspect Workspace"
      },
      {
        "command": "junubAgent.verifyWorkspace",
        "title": "Junub Agent: Verify Workspace"
      },
      {
        "command": "junubAgent.runTask",
        "title": "Junub Agent: Run Task"
      },
      {
        "command": "junubAgent.inspectFilmProject",
        "title": "Junub Agent: Inspect Film Project"
      },
      {
        "command": "junubAgent.loadFilmProject",
        "title": "Junub Agent: Load Film Project"
      },
            { "command": "junubAgent.applyFilmPatch", "title": "Junub Agent: Apply Film Patch" }
    ],
    "views": {
      "explorer": [
        {
          "id": "junubAgentTaskProgress",
          "name": "Junub Agent Progress"
        },
        {
          "id": "junubAgentFilmProject",
          "name": "Junub Agent Film"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
